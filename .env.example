# Скопируйте этот файл в .env и подставьте свои значения:
#   cp .env.example .env
# Файл .env в git не коммитить — в нём токен бота.

# Токен бота от @BotFather (/newbot → скопировать строку вида цифры:буквы)
BOT_TOKEN=123456789:ABCdefGHIjklmnoPQRstUVwxyz

# HTTPS-адрес захостенного index.html. Telegram открывает Mini App только по https.
MINIAPP_URL=https://your-domain.com/index.html

# Опционально. Если задан — бот работает через webhook (продакшен),
# если пусто/не задан — через polling (локальная разработка).
# WEBHOOK_URL=https://your-domain.com/webhook

# Опционально. Порт для webhook, по умолчанию 8080.
# PORT=8080
